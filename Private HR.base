filters:
  and:
    - file.inFolder("00_Private")
    - type == "private-hr"
formulas:
  team: file.folder.replace("00_Private/", "")
properties:
  note.person:
    displayName: Person
  formula.team:
    displayName: Team
  note.job_title:
    displayName: Job title
  note.experience_years:
    displayName: Experience (y)
  note.seniority_date:
    displayName: Seniority date
  note.last_raise_date:
    displayName: Last raise
  note.salary_fixe:
    displayName: Salary (fixe)
  note.bonus:
    displayName: Bonus
  note.experience_coeff:
    displayName: Experience coeff
  note.responsibility_role:
    displayName: Responsibility role
  note.responsibility_coeff:
    displayName: Responsibility coeff
  note.trend_salary:
    displayName: Trend (avg. same coeff)
  note.pct_of_trend:
    displayName: "% of trend"
  note.raise_to_95:
    displayName: Raise → 95 %
  note.raise_to_100:
    displayName: Raise → 100 %
views:
  - type: table
    name: All people
    order:
      - person
      - formula.team
      - job_title
      - experience_years
      - seniority_date
      - last_raise_date
      - salary_fixe
      - bonus
      - experience_coeff
      - responsibility_role
      - responsibility_coeff
      - trend_salary
      - pct_of_trend
      - raise_to_95
      - raise_to_100
    sort:
      - property: formula.team
        direction: ASC
      - property: person
        direction: ASC
    summaries:
      salary_fixe: Sum
      bonus: Sum
      raise_to_95: Sum
      raise_to_100: Sum
  - type: table
    name: Below trend
    filters:
      and:
        - pct_of_trend < 100
    order:
      - person
      - formula.team
      - responsibility_role
      - salary_fixe
      - trend_salary
      - pct_of_trend
      - raise_to_95
      - raise_to_100
      - last_raise_date
    sort:
      - property: pct_of_trend
        direction: ASC
    summaries:
      raise_to_95: Sum
      raise_to_100: Sum
  - type: table
    name: By team
    groupBy:
      property: formula.team
      direction: ASC
    order:
      - person
      - job_title
      - salary_fixe
      - bonus
      - responsibility_role
      - pct_of_trend
      - raise_to_95
      - raise_to_100
    sort:
      - property: person
        direction: ASC
    summaries:
      salary_fixe: Sum
      raise_to_95: Sum
      raise_to_100: Sum
